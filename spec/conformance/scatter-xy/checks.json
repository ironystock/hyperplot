{
  "fixture": "scatter-xy",
  "about": "A two-series scatter on a linear x axis: mode xy metadata (one row per point, keyed by x), keyboard order, the point table with per-series row ids, select of a point, and brush rounding on a linear axis.",
  "level": 3,
  "input": "input.json",
  "reference": { "chart": "chart.svg", "table": "table.html" },
  "forbid": {
    "elements": ["script", "foreignObject"], "attrs": ["style"], "attrPrefixes": ["on"],
    "where": [
      { "sel": "svg", "attrs": ["transform"] },
      { "sel": "g.hp-marks", "attrs": ["transform"], "elements": ["svg", "symbol", "use"], "deep": true },
      { "sel": "g.hp-labels", "attrs": ["transform"], "elements": ["svg", "symbol", "use"], "deep": true },
      { "sel": "g.hp-axis-x", "attrs": ["transform"], "elements": ["svg", "symbol", "use"], "deep": true },
      { "sel": "g.hp-hover", "attrs": ["transform"], "deep": true },
      { "sel": "rect.hp-band-hl", "attrs": ["transform"] }
    ]
  },
  "server": [
    {
      "sel": "svg", "count": 1, "classes": ["hp"],
      "attrs": { "id": "sx", "data-hp": "1" },
      "match": {
        "data-hp-plot": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?(e[+-][1-9][0-9]*)? -?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?(e[+-][1-9][0-9]*)? -?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?(e[+-][1-9][0-9]*)? -?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?(e[+-][1-9][0-9]*)?$",
        "data-hp-x": "^linear -?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?(e[+-][1-9][0-9]*)? -?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?(e[+-][1-9][0-9]*)?$",
        "data-hp-y": "^linear -?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?(e[+-][1-9][0-9]*)? -?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?(e[+-][1-9][0-9]*)?$"
      }
    },
    { "sel": "g.hp-marks > g.hp-series", "count": 2 },
    { "sel": "g.hp-series > circle.hp-dot", "count": 4, "should": true },
    { "sel": "circle.hp-dot > title", "count": 4, "should": true },
    { "sel": "g.hp-series.hp-s2", "count": 1, "attrs": { "data-hp-series": "POST" }, "should": true },
    { "sel": "g.hp-labels > text.hp-dot-label", "count": 1, "text": "a", "should": true },
    {
      "sel": "g.hp-hover > metadata.hp-tips", "count": 1,
      "tips": { "mode": "xy", "count": 4, "k": ["1", "2", "3", "2"], "names": ["GET", "POST"] }
    },
    { "sel": "g.hp-hover > metadata.hp-tips", "count": 1, "tips": { "slots": [[1, "GET"], [2, "POST"]] }, "should": true },
    { "in": "table", "sel": "table.hp-table", "count": 1, "attrs": { "id": "sx-table" } },
    { "in": "table", "sel": "tbody > tr", "count": 4 },
    { "in": "table", "sel": "tbody > tr#sx-r-7302a987-370cabd5", "count": 1, "should": true }
  ],
  "client": {
    "geometry": { "plot": [24, 26, 228, 98], "x": ["linear", 1, 3], "y": ["linear", 10, 30] },
    "tips": { "mode": "xy", "n": 4, "ord": [0, 3, 1, 2], "k": ["1", "2", "3", "2"] },
    "hover": [
      { "at": [127, 79], "index": 3 },
      { "at": [125, 27], "index": 1 },
      { "at": [126, 50], "index": -1, "note": "24 and 30 px from the nearest points, outside the 12 px hit radius" }
    ],
    "select": [
      {
        "click": [127, 79], "target": "svg",
        "detail": { "chart": "sx", "x": "2", "series": "POST", "index": 3 },
        "params": { "hp-chart": "sx", "hp-x": "2", "hp-series": "POST" },
        "note": "in mode xy the series is the hit point's, found by its slot"
      }
    ],
    "brush": [
      {
        "from": 75, "to": 100,
        "detail": { "chart": "sx", "x0": "1.5", "x1": "1.7451" },
        "note": "span 2 over 204 px: 4 decimals resolve a tenth of a pixel"
      },
      { "from": 0, "to": 228, "detail": { "chart": "sx", "x0": "1", "x1": "3" }, "note": "0 is clamped to the plot's left edge" }
    ]
  }
}
