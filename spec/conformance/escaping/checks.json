{
  "fixture": "escaping",
  "about": "Markup and control characters in the title, a series name and a category. They must arrive as text everywhere: element text, attributes, the hp-tips JSON (escaped as \\u003c, \\u003e, \\u0026 so it reads the same under XML and HTML parsing), the table, the tooltip, event details and request parameters. TAB, LF and CR in attributes are character references, so they survive attribute normalization; a CR is never a raw byte; U+0001 cannot appear in XML at all, so the markup drops it while the JSON keeps it escaped (spec/spec.md, 'Text and safety').",
  "level": 3,
  "input": "input.json",
  "reference": { "chart": "chart.svg", "table": "table.html" },
  "forbid": {
    "elements": ["script", "foreignObject", "b", "i"], "attrs": ["style"], "attrPrefixes": ["on"],
    "where": [
      { "sel": "svg", "attrs": ["transform"] },
      { "sel": "g.hp-marks", "attrs": ["transform"], "elements": ["svg", "symbol", "use"], "deep": true },
      { "sel": "g.hp-labels", "attrs": ["transform"], "elements": ["svg", "symbol", "use"], "deep": true },
      { "sel": "g.hp-axis-x", "attrs": ["transform"], "elements": ["svg", "symbol", "use"], "deep": true },
      { "sel": "g.hp-hover", "attrs": ["transform"], "deep": true },
      { "sel": "rect.hp-band-hl", "attrs": ["transform"] }
    ]
  },
  "raw": { "absent": ["<script", "</script", "\r", "\u0001"] },
  "tipsRaw": { "absent": ["<", ">", "&"] },
  "server": [
    { "sel": "svg", "count": 1, "attrs": { "id": "esc", "data-hp": "1", "data-hp-x": "band" } },
    { "sel": "svg > title", "count": 1, "text": "Q&A <1>" },
    { "sel": "g.hp-series", "count": 1, "attrs": { "data-hp-series": "<script>\"x\"&'y'</script>\t\n\rz" } },
    { "sel": "path.hp-bar > title", "count": 2, "should": true },
    {
      "sel": "g.hp-hover > metadata.hp-tips", "count": 1,
      "tips": { "mode": "band", "count": 2, "k": ["a<b", "c&d\t\n\r\u0001e"], "names": ["<script>\"x\"&'y'</script>\t\n\r\u0001z"] }
    },
    { "in": "table", "sel": "table > caption", "count": 1, "text": "Q&A <1>" },
    { "in": "table", "sel": "thead > tr > th", "count": 2 },
    { "in": "table", "sel": "tbody > tr > th[scope=\"row\"]", "count": 2 },
    { "in": "table", "sel": "tbody > tr#esc-r-f04a1854 > th", "count": 1, "text": "c&d\t\n\re", "should": true }
  ],
  "client": {
    "tips": { "mode": "band", "n": 2, "ord": [0, 1], "k": ["a<b", "c&d\t\n\r\u0001e"] },
    "tooltip": [
      {
        "at": [75, 60],
        "heading": "a<b",
        "rows": [[1, "<script>\"x\"&'y'</script>\t\n\r\u0001z", "1"]],
        "note": "every string is inserted with textContent: the tooltip holds no element created from data"
      }
    ],
    "select": [
      {
        "click": [75, 60], "target": "#esc-b-82a3605c-28aead16",
        "detail": { "chart": "esc", "x": "a<b", "series": "<script>\"x\"&'y'</script>\t\n\rz", "index": 0 },
        "params": { "hp-chart": "esc", "hp-x": "a<b", "hp-series": "<script>\"x\"&'y'</script>\t\n\rz" },
        "query": "hp-chart=esc&hp-x=a%3Cb&hp-series=%3Cscript%3E%22x%22%26%27y%27%3C%2Fscript%3E%09%0A%0Dz",
        "note": "series comes from data-hp-series, where the markup dropped U+0001"
      },
      {
        "click": [177, 60], "target": "svg",
        "detail": { "chart": "esc", "x": "c&d\t\n\r\u0001e", "series": "", "index": 1 },
        "params": { "hp-chart": "esc", "hp-x": "c&d\t\n\r\u0001e" },
        "query": "hp-chart=esc&hp-x=c%26d%09%0A%0D%01e",
        "note": "x is the row key from the JSON, so it round-trips to the server's own category exactly"
      }
    ]
  }
}
