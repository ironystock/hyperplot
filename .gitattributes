# Normalize every text file to LF in the repository and in working trees,
# on every platform. Golden tests compare bytes, so CRLF would break them.
* text=auto eol=lf

*.go     text eol=lf diff=golang
*.mod    text eol=lf
*.sum    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.json   text eol=lf
*.md     text eol=lf diff=markdown
*.yml    text eol=lf
*.yaml   text eol=lf
*.html   text eol=lf diff=html
*.css    text eol=lf diff=css
*.svg    text eol=lf
Makefile text eol=lf

# Golden files are generated output: keep them as LF text, collapse them in
# GitHub diffs, and leave them out of language statistics. Use
# `git diff --text` (or `git diff -a`) to see their contents locally.
testdata/**/*.svg  text eol=lf -diff linguist-generated=true
testdata/**/*.html text eol=lf -diff linguist-generated=true

# Conformance fixtures are part of the wire spec (docs/spec.md) and are
# reviewed by hand: keep their diffs visible.
testdata/conformance/**/*.svg  text eol=lf diff linguist-generated=false
testdata/conformance/**/*.html text eol=lf diff linguist-generated=false

# Fuzz corpora are generated by `go test -fuzz`.
testdata/fuzz/**   text eol=lf linguist-generated=true

# Binary files.
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
